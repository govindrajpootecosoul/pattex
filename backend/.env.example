PORT=3026
# Main DB for users (collection: userspattex_emami). Company data lives in DBs like pattex, emami on same cluster.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.2ift0zy.mongodb.net/maindb?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-in-production
# Session lifetime for login tokens (default 30d = 1 month). Examples: 30d, 7d, 12h
JWT_EXPIRES_IN=30d

# Optional Redis cache for dashboard aggregations (strongly recommended in production)
# REDIS_CACHE_ENABLED=true
# REDIS_URL=redis://127.0.0.1:6379

# Auth middleware: cache User.findById lookups (default 5 minutes)
# AUTH_USER_CACHE_TTL_MS=300000

# Optional: create recommended MongoDB indexes on server start (set to true once, then disable)
# ENSURE_COMPANY_INDEXES=true

